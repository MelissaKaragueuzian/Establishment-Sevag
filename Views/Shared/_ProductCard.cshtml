@model Product
@{
    var image = Model.Photos.FirstOrDefault();
    var label = ViewData["CardLabel"] as string;
    var hasDimensions = !string.IsNullOrWhiteSpace(Model.Dimensions);
}
<a class="collection-card" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
    <div class="collection-media" data-zoom-src="@image?.ImagePath" data-zoom-title="@Model.Name">
        @if (image is null)
        {
            <div class="photo-fallback"><span>@Model.Category</span></div>
        }
        else
        {
            <img src="@image.ImagePath" alt="@Model.Name" loading="lazy" />
            <span class="zoom-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6" /></svg>
            </span>
        }
        @if (label is not null || hasDimensions)
        {
            <span class="collection-foot">
                <span>@label</span>
                @if (hasDimensions)
                {
                    <span>@Model.Dimensions</span>
                }
            </span>
        }
    </div>
    <div class="collection-body">
        <h3>@Model.Name</h3>
        <p>@Model.Description</p>
        <span class="collection-meta">
            <span>@Model.Category</span>
            <span class="collection-cta">View piece <span aria-hidden="true">→</span></span>
        </span>
    </div>
</a>
